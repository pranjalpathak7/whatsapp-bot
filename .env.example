# Groq AI Configuration
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Drive Architecture
# Folder ID where downloaded media will be uploaded
DRIVE_FOLDER_ID=your_google_drive_folder_id_here
# Path to Google Service Account or OAuth credentials JSON file
DRIVE_CREDENTIALS_FILE=drive_pass.json

# Web Dashboard Configuration
DASHBOARD_PASSWORD=your_dashboard_password_here
PORT=3000

# Target Phone for Presence Tracking (Country Code + 10-digit number without '+')
TARGET_PHONE=919876543210
